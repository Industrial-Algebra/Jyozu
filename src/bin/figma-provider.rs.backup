use anyhow::Result;
use clap::{Parser, Subcommand};
use serde::{Serialize};
use serde_json::{Value, json};

/// Figma Provider for Lonis harness
#[derive(Parser)]
#[command(name = "figma-provider")]
#[command(about = "Lonis-compatible Figma provider", long_about = None)]
struct Cli {
    #[command(subcommand)]
    command: Commands,
}

#[derive(Subcommand)]
enum Commands {
    /// Show provider manifest
    Manifest,
    /// List available tools
    ToolsList,
    /// Describe a specific tool
    ToolsDescribe {
        /// Tool name
        #[arg(value_name = "TOOL")]
        tool: String,
    },
    /// Call a tool with JSON arguments
    Call {
        /// Tool name
        #[arg(value_name = "TOOL")]
        tool: String,
        /// JSON arguments
        #[arg(value_name = "ARGS")]
        args: Value,
    },
    /// Show provider status
    Status,
    /// Run provider diagnostics
    Doctor,
}

#[derive(Serialize)]
struct Manifest {
    provider: ProviderInfo,
    tools: Vec<String>,
}

#[derive(Serialize)]
struct ProviderInfo {
    name: String,
    version: String,
}

#[derive(Serialize)]
struct ToolDescription {
    name: String,
    description: String,
    input_schema: Value,
}

fn main() -> Result<()> {
    let cli = Cli::parse();

    match cli.command {
        Commands::Manifest => {
            let manifest = Manifest {
                provider: ProviderInfo {
                    name: "figma".to_string(),
                    version: "0.1.0".to_string(),
                },
                tools: get_tool_names(),
            };
            println!("{}", serde_json::to_string_pretty(&manifest)?);
        }
        Commands::ToolsList => {
            let tools = get_tool_names();
            println!("{}", serde_json::to_string_pretty(&tools)?);
        }
        Commands::ToolsDescribe { tool } => {
            if let Some(desc) = get_tool_description(&tool) {
                println!("{}", serde_json::to_string_pretty(&desc)?);
            } else {
                eprintln!("Tool not found: {}", tool);
                std::process::exit(1);
            }
        }
        Commands::Call { tool, args } => {
            // TODO: Implement actual tool call via Figma bridge
            // For now, return a mock success
            let result = Value::Object(vec![(
                "success".to_string(),
                Value::Bool(true),
            )].into_iter().collect());
            println!("{}", serde_json::to_string_pretty(&result)?);
        }
        Commands::Status => {
            let status = json!({ "status": "ok" });
            println!("{}", serde_json::to_string_pretty(&status)?);
        }
        Commands::Doctor => {
            let doctor = json!({
                "status": "ok",
                "checks": {
                    "figma_connection": {
                        "status": "unknown",
                        "detail": "Not implemented"
                    }
                }
            });
            println!("{}", serde_json::to_string_pretty(&doctor)?);
        }
    }

    Ok(())
}

fn get_tool_description(tool: &str) -> Option<ToolDescription> {
    let (desc, schema) = match tool {
        "join_channel" => (
            "Connect to a Figma plugin channel. Required before using other tools.",
            json!({
                "type": "object",
                "properties": {
                    "channel": { "type": "string", "description": "The channel ID displayed in the Figma plugin" },
                    "url": { "type": "string", "description": "Optional WebSocket URL (default: ws://localhost:3055)" }
                },
                "required": ["channel"]
            }),
        ),
        "get_document_info" => (
            "Get information about the current Figma document including pages",
            json!({
                "type": "object",
                "properties": {
                    "channel": { "type": "string", "description": "The channel ID" }
                },
                "required": ["channel"]
            }),
        ),
        "get_page_info" => (
            "Get information about a specific page or the current page",
            json!({
                "type": "object",
                "properties": {
                    "channel": { "type": "string", "description": "The channel ID" },
                    "pageId": { "type": "string", "description": "Page ID (default: current page)" }
                },
                "required": ["channel"]
            }),
        ),
        "get_selection" => (
            "Get the currently selected nodes in Figma",
            json!({
                "type": "object",
                "properties": {
                    "channel": { "type": "string", "description": "The channel ID" },
                    "includeGeometry": { "type": "boolean", "description": "Include node geometry/position data" }
                },
                "required": ["channel"]
            }),
        ),
        "get_node_info" => (
            "Get detailed information about a specific node",
            json!({
                "type": "object",
                "properties": {
                    "channel": { "type": "string", "description": "The channel ID" },
                    "nodeId": { "type": "string", "description": "Figma node ID" },
                    "includeChildren": { "type": "boolean", "description": "Include child node information" }
                },
                "required": ["channel", "nodeId"]
            }),
        ),
        "find_nodes_by_name" => (
            "Find nodes by name pattern",
            json!({
                "type": "object",
                "properties": {
                    "channel": { "type": "string", "description": "The channel ID" },
                    "name": { "type": "string", "description": "Node name to search for" },
                    "type": { "type": "string", "description": "Filter by node type (e.g., 'FRAME', 'RECTANGLE')" }
                },
                "required": ["channel", "name"]
            }),
        ),
        "create_frame" => (
            "Create a new frame with optional auto-layout",
            json!({
                "type": "object",
                "properties": {
                    "channel": { "type": "string", "description": "The channel ID" },
                    "name": { "type": "string", "description": "Frame name" },
                    "x": { "type": "number", "description": "X position" },
                    "y": { "type": "number", "description": "Y position" },
                    "width": { "type": "number", "description": "Width" },
                    "height": { "type": "number", "description": "Height" },
                    "parentId": { "type": "string", "description": "Parent node ID (default: current page)" },
                    "layoutMode": { "type": "string", "enum": ["NONE", "HORIZONTAL", "VERTICAL"], "description": "Auto-layout mode" },
                    "padding": { "type": "number", "description": "Padding for auto-layout" },
                    "gap": { "type": "number", "description": "Gap between children in auto-layout" }
                },
                "required": ["channel", "x", "y", "width", "height"]
            }),
        ),
        "create_text" => (
            "Create a new text node",
            json!({
                "type": "object",
                "properties": {
                    "channel": { "type": "string", "description": "The channel ID" },
                    "name": { "type": "string", "description": "Text node name" },
                    "x": { "type": "number", "description": "X position" },
                    "y": { "type": "number", "description": "Y position" },
                    "text": { "type": "string", "description": "Text content" },
                    "fontSize": { "type": "number", "description": "Font size in pixels" },
                    "fontColor": { "type": "object", "description": "Text color with r, g, b, a components (0-1)" },
                    "parentId": { "type": "string", "description": "Parent node ID" }
                },
                "required": ["channel", "x", "y", "text"]
            }),
        ),
        "set_fill" => (
            "Set the fill color of a node",
            json!({
                "type": "object",
                "properties": {
                    "channel": { "type": "string", "description": "The channel ID" },
                    "nodeId": { "type": "string", "description": "Node ID" },
                    "color": { "type": "object", "description": "Fill color with r, g, b, a components (0-1)" },
                    "opacity": { "type": "number", "description": "Fill opacity (0-1)" }
                },
                "required": ["channel", "nodeId", "color"]
            }),
        ),
        "move_node" => (
            "Move a node to a new position",
            json!({
                "type": "object",
                "properties": {
                    "channel": { "type": "string", "description": "The channel ID" },
                    "nodeId": { "type": "string", "description": "Node ID" },
                    "x": { "type": "number", "description": "New X position" },
                    "y": { "type": "number", "description": "New Y position" }
                },
                "required": ["channel", "nodeId", "x", "y"]
            }),
        ),
        "delete_node" => (
            "Delete a node. Requires MCP server startup with --allow-destructive-tools and confirm=true",
            json!({
                "type": "object",
                "properties": {
                    "channel": { "type": "string", "description": "The channel ID" },
                    "nodeId": { "type": "string", "description": "Node ID to delete" },
                    "confirm": { "type": "boolean", "description": "Must be true to confirm destructive deletion. Execution also requires MCP server startup with --allow-destructive-tools" },
                    "dryRun": { "type": "boolean", "description": "Preview the destructive action without executing it. Dry runs remain allowed even when destructive execution is disabled" },
                    "reason": { "type": "string", "description": "Optional human-readable reason for the destructive action" }
                },
                "required": ["channel", "nodeId"]
            }),
        ),
        _ => {
            // Placeholder for other tools
            return Some(ToolDescription {
                name: tool.to_string(),
                description: format!("{} tool (placeholder)", tool),
                input_schema: json!({}),
            });
        }
    };
    Some(ToolDescription {
        name: tool.to_string(),
        description: desc.to_string(),
        input_schema: schema,
    })
}

